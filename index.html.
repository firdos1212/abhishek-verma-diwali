
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Abhishek Verma - Diwali Surprise ❤️</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{
 width:100%;height:100%;overflow:hidden;
 background:#100817;font-family:Arial,sans-serif;
}
canvas{display:block}
#message{
 position:fixed;top:4%;left:0;width:100%;
 text-align:center;color:#ffdf65;
 font-size:clamp(15px,4vw,23px);
 font-weight:bold;line-height:1.5;
 text-shadow:0 0 10px orange,0 0 20px red;
 z-index:5;pointer-events:none;
}
#name{
 position:fixed;top:14%;width:100%;
 text-align:center;color:white;
 font-size:18px;font-weight:bold;
 text-shadow:0 0 12px #ff8800;
 z-index:5;pointer-events:none;
}
#buttons{
 position:fixed;bottom:18px;width:100%;
 display:flex;justify-content:center;gap:10px;z-index:10;
}
button{
 border:0;border-radius:25px;padding:12px 18px;
 background:linear-gradient(45deg,#ff5b16,#ffcc37);
 color:#321306;font-weight:bold;font-size:14px;
}
</style>
</head>

<body>

<div id="message">
✨ It's 8th November Diwali ✨<br>
So you gifted this to your girlfriend ❤️
</div>

<div id="name">ABHISHEK VERMA ❤️</div>

<div id="buttons">
<button onclick="restart()">▶ Replay</button>
<button onclick="recordVideo()">🎥 Create Video</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x160b20);
scene.fog=new THREE.Fog(0x160b20,25,65);

const camera=new THREE.PerspectiveCamera(
55,innerWidth/innerHeight,0.1,100
);

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.3;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffd9b0,0x392033,2));

const mainLight=new THREE.DirectionalLight(0xffd5a0,2);
mainLight.position.set(-5,15,10);
mainLight.castShadow=true;
scene.add(mainLight);

const warmLight=new THREE.PointLight(0xff8a22,40,35);
warmLight.position.set(0,8,-5);
scene.add(warmLight);

function material(color,roughness=0.8){
 return new THREE.MeshStandardMaterial({
  color:color,roughness:roughness
 });
}

function box(x,y,z,w,h,d,color){
 const m=new THREE.Mesh(
  new THREE.BoxGeometry(w,h,d),material(color)
 );
 m.position.set(x,y,z);
 m.castShadow=true;
 m.receiveShadow=true;
 scene.add(m);
 return m;
}

function sphere(x,y,z,r,color){
 const m=new THREE.Mesh(
  new THREE.SphereGeometry(r,16,16),material(color)
 );
 m.position.set(x,y,z);
 scene.add(m);
 return m;
}

// GROUND AND STREET

box(0,-0.45,-15,35,0.7,65,0x754c42);
box(0,-0.05,-15,9,0.12,65,0x49332e);

// ROAD BRICKS

for(let z=-43;z<15;z+=1.3){
 for(let x=-4;x<=4;x+=1.3){
  box(x,0.02,z,1.22,0.04,1.22,0xa16d5a);
 }
}

// BUILDINGS

function building(x,z,color){

 box(x,4,z,6,8,6,color);

 // Roof
 box(x,8.1,z,6.5,0.3,6.5,0xffa23a);

 // Front decoration
 box(x,3.7,z-3.08,6,0.15,0xffc04b);

 // Door
 box(x,1.5,z-3.13,1.8,3,0x451b15);

 // Door frame
 box(x,3.1,z-3.22,2.1,0.15,0xffbd3d);
 box(x-1,1.5,z-3.22,0.12,3.1,0xffbd3d);
 box(x+1,1.5,z-3.22,0.12,3.1,0xffbd3d);

 // Windows
 for(let i of [-2,2]){
  box(x+i,5.2,z-3.12,1.3,1.7,0x291923);
  box(x+i,5.2,z-3.2,0.95,1.35,0xffc957);
  box(x+i,6.1,z-3.3,1.5,0.12,0xff9c28);
  box(x+i,4.3,z-3.3,1.5,0.12,0xff9c28);
 }

 // Balcony
 box(x,3.35,z-3.5,5,0.13,0x251d20);
 for(let i=-2.2;i<=2.2;i+=0.45){
  box(x+i,3.75,z-3.5,0.08,0.8,0x292020);
 }

 // Roof ornaments
 for(let i=-2;i<=2;i++){
  sphere(x+i,8.5,z,0.13,0xffd04b);
 }

 // Hanging garland
 for(let i=-2.5;i<=2.5;i+=0.4){
  sphere(x+i,7.2,z-3.35,0.11,0xffd43a);
 }
}

// Rows of colorful houses

building(-7,-3,0xd65332);
building(7,-3,0x306db7);

building(-7,-12,0xe87535);
building(7,-12,0x9343a8);

building(-7,-21,0xc64c30);
building(7,-21,0x3175bd);

building(-7,-30,0xe36b37);
building(7,-30,0x8240a1);

// DIYAS

const flames=[];

function diya(x,z){

 const base=new THREE.Mesh(
  new THREE.SphereGeometry(0.34,16,12),
  material(0xe66b19)
 );
 base.scale.y=0.45;
 base.position.set(x,0.22,z);
 scene.add(base);

 const flame=new THREE.Mesh(
  new THREE.ConeGeometry(0.13,0.48,12),
  new THREE.MeshBasicMaterial({color:0xffdc39})
 );
 flame.position.set(x,0.52,z);
 scene.add(flame);
 flames.push(flame);

 const glow=new THREE.PointLight(0xff9b28,1.8,3);
 glow.position.set(x,0.6,z);
 scene.add(glow);
}

for(let z=-34;z<10;z+=3){
 diya(-4.8,z);
 diya(4.8,z);
}

// RANGOLI

const rangoli=new THREE.Group();
rangoli.position.set(0,0.08,-6);
scene.add(rangoli);

const colors=[
 0xff2594,0xffd22f,0x24d9ff,
 0x9b42ff,0xff6a20,0xffffff
];

for(let i=0;i<12;i++){
 const angle=i*Math.PI/6;

 const petal=new THREE.Mesh(
  new THREE.CircleGeometry(0.85,6),
  new THREE.MeshBasicMaterial({
   color:colors[i%colors.length],
   side:THREE.DoubleSide
  })
 );

 petal.position.set(
  Math.cos(angle)*0.8,0,Math.sin(angle)*0.8
 );
 petal.rotation.x=-Math.PI/2;
 rangoli.add(petal);
}

const center=new THREE.Mesh(
 new THREE.CircleGeometry(0.5,32),
 new THREE.MeshBasicMaterial({color:0xffd82f})
);
center.rotation.x=-Math.PI/2;
center.position.y=0.02;
rangoli.add(center);

// FLOWER PETALS

for(let i=0;i<8;i++){
 const a=i*Math.PI/4;
 const p=new THREE.Mesh(
  new THREE.CircleGeometry(0.3,16),
  new THREE.MeshBasicMaterial({color:0xffffff})
 );
 p.position.set(Math.cos(a)*0.4,0.03,Math.sin(a)*0.4);
 p.rotation.x=-Math.PI/2;
 rangoli.add(p);
}

// ROMANTIC COUPLE

function person(x,z,shirt,hair){

 const group=new THREE.Group();
 group.position.set(x,0,z);
 scene.add(group);

 // Body
 const body=new THREE.Mesh(
  new THREE.CapsuleGeometry(0.32,0.85,5,12),
  material(shirt)
 );
 body.position.y=1.05;
 group.add(body);

 // Head
 const head=new THREE.Mesh(
  new THREE.SphereGeometry(0.34,20,20),
  material(0xffc18e)
 );
 head.position.y=1.95;
 group.add(head);

 // Hair
 const hairMesh=new THREE.Mesh(
  new THREE.SphereGeometry(0.36,20,12),
  material(hair)
 );
 hairMesh.scale.y=0.62;
 hairMesh.position.y=2.12;
 group.add(hairMesh);

 // Legs
 for(let i=-1;i<=1;i+=2){
  const leg=new THREE.Mesh(
   new THREE.BoxGeometry(0.16,0.65,0.2),
   material(0x24191d)
  );
  leg.position.set(i*0.15,0.32,0);
  group.add(leg);
 }

 return group;
}

const girl=person(-0.38,-1,0xf02e83,0x171014);
const boy=person(0.38,-1,0xffffff,0x19110e);

// Small heart above couple

const heartShape=new THREE.Shape();
heartShape.moveTo(0,0.2);
heartShape.bezierCurveTo(-0.7,0.8,-1.1,0,0,-0.8);
heartShape.bezierCurveTo(1.1,0,0.7,0.8,0,0.2);

const heart=new THREE.Mesh(
 new THREE.ShapeGeometry(heartShape),
 new THREE.MeshBasicMaterial({
  color:0xff1744,side:THREE.DoubleSide
 })
);
heart.scale.set(0.55,0.55,0.55);
heart.position.set(0,3.3,-1);
scene.add(heart);

// BUNNY

const bunny=new THREE.Group();
bunny.position.set(2,0.15,-1);
scene.add(bunny);

const white=material(0xffffff);
const body=new THREE.Mesh(
 new THREE.SphereGeometry(0.34,16,16),white
);
body.scale.set(1,1.15,0.8);
bunny.add(body);

const head=new THREE.Mesh(
 new THREE.SphereGeometry(0.25,16,16),white
);
head.position.set(0,0.42,0);
bunny.add(head);

for(let i of [-1,1]){
 const ear=new THREE.Mesh(
  new THREE.CapsuleGeometry(0.075,0.45,4,8),white
 );
 ear.position.set(i*0.13,0.85,0);
 ear.rotation.z=-i*0.17;
 bunny.add(ear);
}

sphere(2,0.62,-0.8,0.045,0xffa0a0);

// STAR IN SKY

const star=new THREE.Mesh(
 new THREE.OctahedronGeometry(0.8),
 new THREE.MeshBasicMaterial({color:0xffdd43})
);
star.position.set(0,12,-18);
scene.add(star);

// STREET LAMPS

for(let z=-30;z<10;z+=7){
 for(let side of [-1,1]){
  const x=side*5.5;
  box(x,2.8,z,0.13,5.5,0.13,0x352322);
  sphere(x,5.7,z,0.23,0xffd34b);

  const lamp=new THREE.PointLight(0xffa62b,4,9);
  lamp.position.set(x,5.7,z);
  scene.add(lamp);
 }
}

// HANGING LIGHTS

const bulbs=[];

for(let i=0;i<40;i++){
 const bulb=new THREE.Mesh(
  new THREE.SphereGeometry(0.1,10,10),
  new THREE.MeshBasicMaterial({color:colors[i%colors.length]})
 );

 bulb.position.set(
  -8+(i%20)*0.85,
  9,
  -16+Math.floor(i/20)*2
 );
 scene.add(bulb);
 bulbs.push(bulb);
}

// SKY STARS

for(let i=0;i<100;i++){
 const s=new THREE.Mesh(
  new THREE.SphereGeometry(0.035,6,6),
  new THREE.MeshBasicMaterial({color:0xffffff})
 );
 s.position.set(
  (Math.random()-0.5)*40,
  9+Math.random()*12,
  -35+Math.random()*30
 );
 scene.add(s);
}

// FIREWORK PARTICLES

const fireworks=[];

function firework(){

 const group=new THREE.Group();
 const color=colors[Math.floor(Math.random()*colors.length)];

 for(let i=0;i<45;i++){
  const p=new THREE.Mesh(
   new THREE.SphereGeometry(0.055,6,6),
   new THREE.MeshBasicMaterial({color})
  );

  const a=Math.random()*Math.PI*2;
  const e=Math.random()*Math.PI;

  p.userData.velocity=new THREE.Vector3(
   Math.cos(a)*Math.sin(e),
   Math.cos(e),
   Math.sin(a)*Math.sin(e)
  );

  group.add(p);
 }

 group.position.set(
  (Math.random()-0.5)*12,
  9+Math.random()*5,
  -14-Math.random()*15
 );

 scene.add(group);
 fireworks.push(group);
}

for(let i=0;i<4;i++)firework();

// CAMERA ANIMATION

let time=0;
let startTime=performance.now();

function animate(){

 requestAnimationFrame(animate);
 time+=0.01;

 // Camera moves forward and looks around street
 const phase=(time%25);

 camera.position.x=Math.sin(phase*0.3)*1.4;
 camera.position.y=4.5+Math.sin(time*0.7)*0.3;
 camera.position.z=13-phase*0.3;

 camera.lookAt(
  Math.sin(time*0.25)*0.6,
  2,
  -7
 );

 // Couple movement
 girl.rotation.y=Math.sin(time*1.8)*0.12;
 boy.rotation.y=-Math.sin(time*1.8)*0.12;

 // Floating heart
 heart.position.y=3.3+Math.sin(time*3)*0.15;
 heart.rotation.y=Math.sin(time)*0.12;

 // Rangoli spin
 rangoli.rotation.y+=0.003;

 // Star spin
 star.rotation.y+=0.015;
 star.rotation.x+=0.006;

 // Bunny hopping
 bunny.position.y=0.15+Math.abs(Math.sin(time*3))*0.13;

 // Light flickering
 bulbs.forEach((b,i)=>{
  b.scale.setScalar(0.75+Math.sin(time*4+i)*0.2);
 });

 flames.forEach((f,i)=>{
  f.scale.y=0.85+Math.sin(time*7+i)*0.2;
 });

 // Fireworks particles
 fireworks.forEach(group=>{
  group.children.forEach(p=>{
   p.position.addScaledVector(p.userData.velocity,0.025);
  });
 });

 warmLight.intensity=35+Math.sin(time*4)*5;

 renderer.render(scene,camera);
}

animate();

// REPLAY

function restart(){
 time=0;
 camera.position.set(0,4.5,13);
}

// VIDEO RECORDING

function recordVideo(){

 const button=document.querySelector("#record");
 if(!window.MediaRecorder){
  alert("Video recording is not supported in this browser. Try Chrome.");
  return;
 }

 const stream=renderer.domElement.captureStream(30);

 let options={};
 if(MediaRecorder.isTypeSupported("video/webm;codecs=vp9")){
  options.mimeType="video/webm;codecs=vp9";
 }else if(MediaRecorder.isTypeSupported("video/webm")){
  options.mimeType="video/webm";
 }

 let recorder;
 try{
  recorder=new MediaRecorder(stream,options);
 }catch(e){
  alert("Recording could not start. Try Chrome.");
  return;
 }

 const chunks=[];
 recorder.ondataavailable=e=>{
  if(e.data.size>0)chunks.push(e.data);
 };

 recorder.onstop=()=>{
  const blob=new Blob(chunks,{type:"video/webm"});
  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");
  a.href=url;
  a.download="Abhishek-Verma-Diwali.webm";
  a.click();
  setTimeout(()=>URL.revokeObjectURL(url),5000);
  button.textContent="🎥 Create Video";
  button.disabled=false;
  stream.getTracks().forEach(t=>t.stop());
 };

 button.textContent="Recording...";
 button.disabled=true;
 restart();
 recorder.start();

 setTimeout(()=>{
  if(recorder.state==="recording")recorder.stop();
 },20000);
}

// RESIZE

window.addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

</script>
</body>
</html>
