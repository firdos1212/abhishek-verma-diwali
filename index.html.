<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Abhishek Verma - Diwali Surprise</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  overflow:hidden;
  background:#100719;
  font-family:Arial,sans-serif;
}
canvas{display:block}
#title{
  position:absolute;
  top:5%;
  width:100%;
  text-align:center;
  color:#ffe45c;
  font-size:17px;
  font-weight:bold;
  text-shadow:0 0 12px orange,0 0 20px red;
  z-index:5;
}
#name{
  position:absolute;
  top:12%;
  width:100%;
  text-align:center;
  color:white;
  font-size:25px;
  font-weight:bold;
  text-shadow:0 0 15px #ff9b00;
  z-index:5;
}
#record{
  position:absolute;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  padding:13px 25px;
  border:0;
  border-radius:30px;
  background:linear-gradient(45deg,#ff4d00,#ffcc00);
  color:white;
  font-size:15px;
  font-weight:bold;
  z-index:10;
}
</style>
</head>

<body>

<div id="title">
  ✨ HAPPY DIWALI ✨
</div>

<div id="name">
  Abhishek Verma ❤️
</div>

<button id="record" onclick="recordVideo()">
  Create Diwali Video 🎥
</button>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r160/three.min.js"></script>

<script>
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x160719);
scene.fog = new THREE.Fog(0x160719,20,65);

const camera = new THREE.PerspectiveCamera(
  60,innerWidth/innerHeight,0.1,1000
);

const renderer = new THREE.WebGLRenderer({
  antialias:true,
  preserveDrawingBuffer:true
});

renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.4;

document.body.appendChild(renderer.domElement);

// LIGHTS
scene.add(new THREE.AmbientLight(0xffffff,1.5));

const moonLight=new THREE.DirectionalLight(0xffd6a0,2);
moonLight.position.set(-10,20,10);
moonLight.castShadow=true;
scene.add(moonLight);

const warmLight=new THREE.PointLight(0xff6600,100,35);
warmLight.position.set(0,8,0);
scene.add(warmLight);

// MATERIALS
function mat(color,roughness=0.8){
 return new THREE.MeshStandardMaterial({
  color,
  roughness
 });
}

// OBJECT CREATOR
function cube(x,y,z,w,h,d,color){
 const mesh=new THREE.Mesh(
  new THREE.BoxGeometry(w,h,d),
  mat(color)
 );
 mesh.position.set(x,y,z);
 mesh.castShadow=true;
 mesh.receiveShadow=true;
 scene.add(mesh);
 return mesh;
}

// GROUND
cube(0,-0.4,-10,35,0.7,65,0x8e6254);

// ROAD
cube(0,-0.02,-10,9,0.1,65,0x6e4840);

// ROAD BRICKS
for(let z=-38;z<20;z+=1.2){
 for(let x=-4;x<=4;x+=1.2){
  cube(x,0.04,z,1.1,0.05,1.1,0xb87962);
 }
}

// BUILDINGS
function building(x,z,color){

 // Main building
 cube(x,4,z,6,8,6,color);

 // Roof
 cube(x,8.1,z,6.5,0.25,6.5,0xffa43b);

 // Front decoration
 cube(x,4,z-3.08,6,0.15,0xffc15a);

 // Door
 cube(x,1.6,z-3.12,1.7,3.1,0x451b15);

 // Door frame
 cube(x,3.3,z-3.2,2,0.15,0xffc02e);

 // Windows
 for(let i=-2;i<=2;i+=4){
  cube(x+i,5.5,z-3.12,1.25,1.6,0x30202b);
  cube(x+i,5.5,z-3.22,0.9,1.25,0xffc94e);

  // Window borders
  cube(x+i,6.35,z-3.3,1.5,0.12,0xff9b22);
  cube(x+i,4.65,z-3.3,1.5,0.12,0xff9b22);
 }

 // Balcony
 cube(x,3.4,z-3.55,5,0.12,0x292020);

 for(let i=-2.2;i<=2.2;i+=0.4){
  cube(x+i,3.8,z-3.55,0.08,0.8,0x282020);
 }

 // Roof decorations
 for(let i=-2;i<=2;i+=1){
  cube(x+i,8.35,z,0.15,0.4,0xffd34b);
 }

 // Hanging lights
 for(let i=-2.5;i<=2.5;i+=0.5){
  const bulb=new THREE.Mesh(
   new THREE.SphereGeometry(0.09,12,12),
   new THREE.MeshBasicMaterial({color:0xffd52a})
  );
  bulb.position.set(x+i,7.5,z-3.4);
  scene.add(bulb);
 }
}

// BUILDING ROWS
building(-7,-2,0xc94b2e);
building(7,-2,0x2864aa);

building(-7,-11,0xe66a32);
building(7,-11,0x8b3b9f);

building(-7,-20,0xc64b29);
building(7,-20,0x2469a5);

building(-7,-29,0xd65a35);
building(7,-29,0x8b398d);

// DIYAS
function diya(x,z){

 const base=new THREE.Mesh(
  new THREE.SphereGeometry(0.35,16,12),
  mat(0xff7515)
 );
 base.scale.y=0.45;
 base.position.set(x,0.25,z);
 scene.add(base);

 const flame=new THREE.Mesh(
  new THREE.ConeGeometry(0.14,0.55,12),
  new THREE.MeshBasicMaterial({color:0xffd72e})
 );
 flame.position.set(x,0.55,z);
 scene.add(flame);

 const glow=new THREE.PointLight(0xff8c21,1.5,3);
 glow.position.set(x,0.7,z);
 scene.add(glow);
}

for(let z=-30;z<10;z+=3){
 diya(-4.8,z);
 diya(4.8,z);
}

// RANGOLI
const rangoli=new THREE.Group();
rangoli.position.set(0,0.13,-5);
scene.add(rangoli);

const colors=[
 0xff0099,0xffd000,0x00d9ff,
 0xff6600,0xffffff,0x9b30ff
];

for(let i=0;i<12;i++){

 const angle=i*Math.PI/6;

 const petal=new THREE.Mesh(
  new THREE.CircleGeometry(0.9,6),
  new THREE.MeshBasicMaterial({
   color:colors[i%colors.length],
   side:THREE.DoubleSide
  })
 );

 petal.position.set(
  Math.cos(angle)*0.8,
  0,
  Math.sin(angle)*0.8
 );

 petal.rotation.x=-Math.PI/2;
 rangoli.add(petal);
}

const center=new THREE.Mesh(
 new THREE.CircleGeometry(0.5,32),
 new THREE.MeshBasicMaterial({color:0xffd000})
);
center.rotation.x=-Math.PI/2;
center.position.y=0.01;
rangoli.add(center);

// COUPLE
function person(x,z,shirt,hairColor){

 const body=new THREE.Mesh(
  new THREE.CapsuleGeometry(0.35,0.9,5,12),
  mat(shirt)
 );
 body.position.set(x,1.15,z);
 scene.add(body);

 const head=new THREE.Mesh(
  new THREE.SphereGeometry(0.36,20,20),
  mat(0xffc18d)
 );
 head.position.set(x,2.05,z);
 scene.add(head);

 const hair=new THREE.Mesh(
  new THREE.SphereGeometry(0.39,20,12),
  mat(hairColor)
 );
 hair.scale.y=0.65;
 hair.position.set(x,2.25,z);
 scene.add(hair);

 // Legs
 for(let i=-1;i<=1;i+=2){
  cube(x+i*0.17,0.35,z,0.17,0.7,0.2,0x251a20);
 }

 return body;
}

const girl=person(-0.35,-1,0xff3290,0x171010);
const boy=person(0.35,-1,0xffffff,0x171010);

// HEART
const heartShape=new THREE.Shape();
heartShape.moveTo(0,0);
heartShape.bezierCurveTo(0,0, -0.5,0.5,-0.8,0.1);
heartShape.bezierCurveTo(-1,-0.5,0,-1,0,-1.3);
heartShape.bezierCurveTo(0,-1,1,-0.5,0.8,0.1);
heartShape.bezierCurveTo(0.5,0.5,0,0,0,0);

const heart=new THREE.Mesh(
 new THREE.ShapeGeometry(heartShape),
 new THREE.MeshBasicMaterial({
  color:0xff1744,
  side:THREE.DoubleSide
 })
);
heart.scale.set(0.5,0.5,0.5);
heart.position.set(0,3,-1);
scene.add(heart);

// BUNNY
const bunny=new THREE.Group();
scene.add(bunny);
bunny.position.set(2,0.2,-1);

const bunnyBody=new THREE.Mesh(
 new THREE.SphereGeometry(0.35,16,16),
 mat(0xffffff)
);
bunnyBody.scale.set(1,1.2,0.8);
bunny.add(bunnyBody);

const bunnyHead=new THREE.Mesh(
 new THREE.SphereGeometry(0.25,16,16),
 mat(0xffffff)
);
bunnyHead.position.set(0,0.4,0);
bunny.add(bunnyHead);

for(let i=-1;i<=1;i+=2){
 const ear=new THREE.Mesh(
  new THREE.CapsuleGeometry(0.08,0.5,4,8),
  mat(0xffffff)
 );
 ear.position.set(i*0.13,0.85,0);
 ear.rotation.z=i*0.2;
 bunny.add(ear);
}

// STAR
const star=new THREE.Mesh(
 new THREE.OctahedronGeometry(1),
 new THREE.MeshBasicMaterial({color:0xffdc35})
);
star.position.set(0,12,-15);
scene.add(star);

// STREET LIGHTS
for(let z=-30;z<10;z+=7){

 for(let side of [-1,1]){
  const x=side*5.5;

  cube(x,3,z,0.12,6,0.12,0x302020);

  const lamp=new THREE.Mesh(
   new THREE.SphereGeometry(0.25,16,16),
   new THREE.MeshBasicMaterial({color:0xffc735})
  );
  lamp.position.set(x,6,z);
  scene.add(lamp);

  const glow=new THREE.PointLight(0xffa52b,5,10);
  glow.position.set(x,6,z);
  scene.add(glow);
 }
}

// HANGING DIWALI LIGHTS
const lights=[];

for(let i=0;i<35;i++){
 const bulb=new THREE.Mesh(
  new THREE.SphereGeometry(0.12,12,12),
  new THREE.MeshBasicMaterial({
   color:colors[i%colors.length]
  })
 );

 bulb.position.set(
  -8+(i%18)*0.9,
  10,
  -15+Math.floor(i/18)*2
 );

 scene.add(bulb);
 lights.push(bulb);
}

// STARS IN SKY
const stars=new THREE.Group();
scene.add(stars);

for(let i=0;i<100;i++){
 const s=new THREE.Mesh(
  new THREE.SphereGeometry(0.035,6,6),
  new THREE.MeshBasicMaterial({color:0xffffff})
 );
 s.position.set(
  (Math.random()-0.5)*45,
  9+Math.random()*15,
  -35+Math.random()*30
 );
 stars.add(s);
}

// FIREWORKS
const fireworks=[];

function createFirework(){
 const group=new THREE.Group();

 const color=colors[Math.floor(Math.random()*colors.length)];

 for(let i=0;i<35;i++){
  const p=new THREE.Mesh(
   new THREE.SphereGeometry(0.055,6,6),
   new THREE.MeshBasicMaterial({color})
  );

  const angle=Math.random()*Math.PI*2;
  const elevation=Math.random()*Math.PI;

  p.userData.velocity=new THREE.Vector3(
   Math.cos(angle)*Math.sin(elevation),
   Math.cos(elevation),
   Math.sin(angle)*Math.sin(elevation)
  );

  group.add(p);
 }

 group.position.set(
  (Math.random()-0.5)*12,
  9+Math.random()*5,
  -15-Math.random()*12
 );

 scene.add(group);
 fireworks.push(group);
}

for(let i=0;i<4;i++)createFirework();

// CAMERA
camera.position.set(0,4,13);
camera.lookAt(0,2,0);

let t=0;

function animate(){

 requestAnimationFrame(animate);
 t+=0.01;

 // Camera movement
 camera.position.x=Math.sin(t*0.35)*2;
 camera.position.y=4.5+Math.sin(t*0.5)*0.5;
 camera.position.z=13-t*0.15;

 if(camera.position.z<5){
  camera.position.z=13;
 }

 camera.lookAt(
  Math.sin(t*0.2)*0.7,
  2,
  -7
 );

 // Couple movement
 girl.rotation.y=Math.sin(t*2)*0.08;
 boy.rotation.y=-Math.sin(t*2)*0.08;

 // Heart animation
 heart.position.y=3+Math.sin(t*3)*0.2;
 heart.scale.setScalar(0.5+Math.sin(t*3)*0.06);

 // Rangoli
 rangoli.rotation.y+=0.003;

 // Star
 star.rotation.y+=0.01;
 star.rotation.x+=0.005;

 // Bunny
 bunny.position.y=0.2+Math.abs(Math.sin(t*3))*0.15;

 // Lights
 lights.forEach((l,i)=>{
  l.scale.setScalar(0.7+Math.sin(t*5+i)*0.3);
 });

 // Fireworks
 fireworks.forEach(group=>{
  group.children.forEach(p=>{
   p.position.addScaledVector(
    p.userData.velocity,0.025
   );
  });
 });

 // Light flickering
 warmLight.intensity=90+Math.sin(t*5)*15;

 renderer.render(scene,camera);
}

animate();

// VIDEO RECORDING
function recordVideo(){

 const button=document.getElementById("record");
 button.style.display="none";

 const stream=renderer.domElement.captureStream(30);

 const recorder=new MediaRecorder(stream,{
  mimeType:"video/webm;codecs=vp9"
 });

 const chunks=[];

 recorder.ondataavailable=e=>{
  if(e.data.size>0)chunks.push(e.data);
 };

 recorder.onstop=()=>{

  const blob=new Blob(chunks,{type:"video/webm"});
  const url=URL.createObjectURL(blob);

  const a=document.createElement("a");
  a.href=url;
  a.download="Abhishek-Verma-Diwali.webm";
  a.click();

  URL.revokeObjectURL(url);
  button.style.display="block";
 };

 recorder.start();

 setTimeout(()=>{
  recorder.stop();
 },20000);
}

// RESIZE
window.addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

</script>
</body>
</html>
